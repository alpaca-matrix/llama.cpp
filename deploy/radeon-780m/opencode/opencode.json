{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-local/balanced",
  "small_model": "llama-local/balanced",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "~/.config/opencode/prompt/core.txt",
    ".opencode/memory/MEMORY.md"
  ],
  "agent": {
    "claude-style": {
      "description": "General-purpose, asks before edit/bash",
      "prompt": "{file:~/.config/opencode/prompt/claude-style.txt}",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "claude-style-plan": {
      "description": "Read-only investigation and planning, no execution",
      "prompt": "{file:~/.config/opencode/prompt/claude-style-plan.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "git diff": "allow",
          "git log*": "allow",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow"
        }
      }
    },
    "claude-style-auto": {
      "description": "High autonomy, edits and safe bash pre-approved",
      "prompt": "{file:~/.config/opencode/prompt/claude-style-auto.txt}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "rm -rf*": "deny",
          "git push --force*": "deny",
          "git reset --hard*": "deny"
        }
      }
    }
  },
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Radeon 780M llama-server",
      "options": {
        "baseURL": "http://192.168.254.250:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "balanced": {
          "name": "balanced - nerkyor Qwen3.6-35B-A3B-DSV4Pro-Thinking-Distill Q6_K (35B-A3B, MTP, vision) - DEFAULT",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "fast": {
          "name": "fast - SC117/Ornith-1.0-35B-MTP-APEX (35B-A3B, MTP, vision)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "deep": {
          "name": "deep - poolside/Laguna-S-2.1 attn-IQ4_XS v3 (118B-A8B, text-only)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
