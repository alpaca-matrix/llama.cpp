[Unit]
Description=llama.cpp router (Radeon 780M / Vulkan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/llama.cpp/build-vk2/bin/llama-server \
  --models-preset /etc/llama/router.ini \
  --models-max 1 \
  --host 0.0.0.0 --port 8080 \
  --metrics
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=65536

# MUL_MAT_ID stays on the Vulkan matvec path up to this many columns (upstream
# default 8). Columns are the whole decode batch, so at parallel = 3 the
# speculating aliases sit at 12 (`fast`), 9 (`kat-eval`) and 15 (`nerkyor-eval`)
# and would otherwise fall to the matrix path whenever every slot is busy.
# Worth ~2-3% there and nothing anywhere else - one and two streams are at 4 and
# 8 columns, already under the default. Measured 2026-08-11, see README.
Environment="GGML_VK_MUL_MAT_VEC_ID_MAX_COLS=12"

# the router spawns a child per model that holds the GPU allocation. Killing it
# mid-decode leaves it unkillable in D state with the whole GTT pool pinned,
# which forces every later Vulkan init to fall back to CPU. Give the children
# a long window to finish in-flight GPU work, and stop the whole cgroup rather
# than the router alone so no child is orphaned holding memory.
# SendSIGKILL is deliberately left enabled: it cannot reap a D-state task, but
# disabling it strands ordinary killable children that then block the next
# start and keep the GTT pinned - which is the failure it was meant to prevent.
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
