[Unit]
Description=llama.cpp router (Radeon 780M / Vulkan)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/llama.cpp/build-vk2/bin/llama-server \
  --models-preset /etc/llama/router.ini \
  --models-max 1 \
  --host 0.0.0.0 --port 8080 \
  --metrics
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=65536

# the router spawns a child per model that holds the GPU allocation. Killing it
# mid-decode leaves it unkillable in D state with the whole GTT pool pinned,
# which forces every later Vulkan init to fall back to CPU. Give the children
# time to finish in-flight work, kill the whole cgroup rather than the router
# alone, and never escalate to SIGKILL - it cannot reap a D-state task anyway.
KillMode=control-group
TimeoutStopSec=120
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
